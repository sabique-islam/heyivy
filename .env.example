# Copy to .env and fill in. Git ignores .env, so never commit real keys.

# Used by the Worker (scripts/dev-worker.sh).
ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Signs device tokens. Create one with: openssl rand -base64 48
DEVICE_TOKEN_SIGNING_KEY=

